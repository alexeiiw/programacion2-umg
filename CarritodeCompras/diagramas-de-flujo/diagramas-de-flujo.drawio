  <diagram id="diagrama-flujo-compra" name="Flujo de Compra y Reglas de Negocio">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header / Titulo -->
        <mxCell id="f_title" value="Diagrama de Flujo: Proceso de Compra E-Commerce con Reglas de Negocio" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="850" height="40" as="geometry" />
        </mxCell>

        <!-- Cuadro de Reglas de Negocio Destacadas -->
        <mxCell id="box_reglas" value="&lt;b&gt;REGLAS DE NEGOCIO APLICADAS:&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-01 (Autenticación):&lt;/b&gt; Solo clientes registrados y autenticados pueden comprar.&lt;br&gt;2. &lt;b&gt;RN-02 (Inventario):&lt;/b&gt; Solo se pueden comprar artículos con existencias en stock (Stock &gt;= Cantidad).&lt;br&gt;3. &lt;b&gt;RN-03 (Método de Pago):&lt;/b&gt; La compra solo puede realizarse exclusivamente con Tarjeta de Crédito." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;align=left;fontColor=#78350F;size=14;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="400" height="110" as="geometry" />
        </mxCell>

        <!-- INICIO -->
        <mxCell id="node_start" value="INICIO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#059669;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Paso 1: Consultar Catalogo -->
        <mxCell id="node_p1" value="Consultar catálogo de productos disponibles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="650" y="180" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Paso 2: Seleccionar Producto y Cantidad -->
        <mxCell id="node_p2" value="Seleccionar producto y definir cantidad deseada (N)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="630" y="270" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- DECISION 1: Validar Inventario (RN-02) -->
